---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { pages, sections, type DocPage } from '../../lib/docs';
import { href, name, repository } from '../../lib/site';

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.slug || undefined }, props: { page } }));
}

const { page } = Astro.props as { page: DocPage };
const entry = await getEntry(page.collection, page.id);
if (!entry) throw new Error(`No Markdown for the docs page “${page.title}” (${page.collection}/${page.id}).`);
const { Content, headings } = await render(entry);
const outline = headings.filter((heading) => heading.depth === 2);

const index = pages.indexOf(page);
const previous = pages[index - 1];
const next = pages[index + 1];
const source = page.collection === 'reference' ? `docs/${page.id}.md` : `site/src/content/docs/${page.id}.md`;
const link = (target: DocPage) => href(`docs/${target.slug}`);
const url = (path: string) => new URL(path, Astro.site).toString();
const structuredData = [
  {
    '@type': 'TechArticle',
    headline: page.title,
    description: page.description,
    url: url(link(page)),
    isPartOf: { '@type': 'WebSite', name, url: url('/') },
    author: { '@type': 'Person', name: 'Marcel Losso' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Docs', item: url('/docs') },
      ...(page.slug ? [{ '@type': 'ListItem', position: 2, name: page.title, item: url(link(page)) }] : []),
    ],
  },
];
---

<Base title={page.title} description={page.description} type="article" {structuredData}>
  <div class="container docs">
    <nav class="sidebar" aria-label="Docs">
      <details open>
        <summary>Docs</summary>
        {
          sections.map((section) => (
            <div class="group">
              <h2>{section.title}</h2>
              <ul>
                {section.pages.map((item) => (
                  <li>
                    <a href={link(item)} aria-current={item === page ? 'page' : undefined}>
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </details>
    </nav>

    <article>
      <h1 class="display">{page.title}</h1>
      <p class="description">{page.description}</p>
      <div class="prose">
        <Content />
      </div>
      <nav class="pager" aria-label="Previous and next">
        {
          previous ? (
            <a href={link(previous)}>
              <span>Previous</span>
              {previous.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="next" href={link(next)}>
              <span>Next</span>
              {next.title}
            </a>
          )
        }
      </nav>
      <a class="edit" href={`${repository}/edit/main/${source}`}>Edit this page on GitHub</a>
    </article>

    {
      outline.length > 1 && (
        <aside class="outline" aria-label="On this page">
          <h2>On this page</h2>
          <ul>
            {outline.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>

<script>
  // Below the breakpoint the navigation folds away; open it again on wide screens.
  const details = document.querySelector<HTMLDetailsElement>('.sidebar details')!;
  const wide = matchMedia('(min-width: 900px)');
  const sync = () => (details.open = wide.matches);
  sync();
  wide.addEventListener('change', sync);
</script>

<style>
  .docs {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 200px;
    gap: 56px;
    padding-top: 40px;
    align-items: start;
  }
  .sidebar,
  .outline {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 104px);
    overflow-y: auto;
    font-size: 14px;
  }
  summary {
    display: none;
  }
  .group + .group {
    margin-top: 24px;
  }
  .sidebar h2,
  .outline h2 {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-tertiary);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sidebar h2 {
    padding-left: 12px;
  }
  .sidebar a {
    display: block;
    padding: 6px 12px;
    border-radius: 7px;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .sidebar a:hover {
    color: var(--text);
    background: var(--fill);
  }
  .sidebar a[aria-current='page'] {
    color: var(--text);
    background: var(--fill-strong);
    font-weight: 500;
  }
  .outline a {
    display: block;
    padding: 4px 0;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 13px;
  }
  .outline a:hover {
    color: var(--text);
  }

  article {
    max-width: 760px;
    min-width: 0;
  }
  h1 {
    font-size: 40px;
  }
  .description {
    margin: 12px 0 32px;
    font-size: 18px;
    color: var(--text-secondary);
  }

  .prose {
    font-size: 16px;
    line-height: 1.7;
  }
  .prose :global(h2) {
    margin: 48px 0 12px;
    font-size: 24px;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .prose :global(h3) {
    margin: 32px 0 8px;
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 16px;
  }
  .prose :global(li) {
    margin-bottom: 6px;
  }
  .prose :global(a) {
    color: var(--accent-text);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .prose :global(:not(pre) > code) {
    font-size: 0.88em;
    padding: 2px 5px;
    border-radius: 5px;
    background: var(--fill);
    overflow-wrap: anywhere;
  }
  .prose :global(pre) {
    margin: 0 0 20px;
    padding: 16px 18px;
    border-radius: 10px;
    background: var(--code-bg) !important;
    box-shadow: var(--ring);
    font-size: 13.5px;
    line-height: 1.6;
    overflow-x: auto;
  }
  .prose :global(table) {
    display: block;
    width: 100%;
    margin: 0 0 24px;
    border-collapse: collapse;
    font-size: 14px;
    overflow-x: auto;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px 14px 10px 0;
    border-bottom: 1px solid var(--separator);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 13px;
  }
  .prose :global(img) {
    display: block;
    margin: 8px auto 28px;
    border-radius: 10px;
    box-shadow: var(--ring-strong);
  }
  .prose :global(blockquote) {
    margin: 0 0 16px;
    padding: 4px 16px;
    border-left: 3px solid var(--accent);
    color: var(--text-secondary);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--separator);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    border-radius: 10px;
    box-shadow: var(--ring);
    text-decoration: none;
    font-weight: 600;
    min-width: 180px;
  }
  .pager a:hover {
    box-shadow: var(--ring-strong);
  }
  .pager span {
    font-size: 12px;
    font-weight: 400;
    color: var(--text-tertiary);
  }
  .pager .next {
    text-align: right;
    margin-left: auto;
  }
  .edit {
    display: inline-block;
    margin-top: 24px;
    font-size: 13px;
    color: var(--text-tertiary);
  }

  @media (max-width: 1180px) {
    .docs {
      grid-template-columns: 200px minmax(0, 1fr);
    }
    .outline {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .docs {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-top: 16px;
    }
    .sidebar {
      position: static;
      max-height: none;
      padding: 12px 16px;
      border-radius: 10px;
      box-shadow: var(--ring);
    }
    summary {
      display: list-item;
      cursor: pointer;
      font-weight: 600;
    }
    details[open] summary {
      margin-bottom: 16px;
    }
    h1 {
      font-size: 32px;
    }
    .pager a {
      min-width: 0;
    }
  }
</style>
