---
import { latestRelease, type Release } from '../lib/release';
import { brewInstall, href, releases } from '../lib/site';

const release = await latestRelease();
const { files } = release;
/** Links to the Releases page (no published release yet) open beside the site. */
const target = (url: string) => (url === releases ? { target: '_blank', rel: 'noopener' } : {});
const download = (key: keyof Release['files']) => ({
  href: release[key],
  ...target(release[key]),
  'data-track': 'download_clicked',
  'data-track-location': 'install_dialog',
  'data-track-package': key.toLowerCase(),
});
/** curl doesn't mark what it downloads as quarantined, so Gatekeeper never checks the DMG or the app. */
const curl = `curl -fLO ${release.mac} && open ${files.mac}`;
---

<dialog class="install" data-install aria-labelledby="install-title">
  <div class="head">
    <h2 id="install-title" class="engraved">Install localhost <span data-platform-name>for macOS</span></h2>
    <button type="button" class="close" data-close aria-label="Close">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="m3 3 8 8M11 3l-8 8"></path></svg>
    </button>
  </div>
  <p class="sub" data-sub>Two quick steps, usually under a minute.</p>

  <section data-panel="macos">
    <ol class="steps">
      <li class="step first">
        <span class="number" aria-hidden="true">1</span>
        <div>
          <h3>Drag it to Applications</h3>
          <p>Open <code>{files.mac}</code> and drag <strong>localhost</strong> to <strong>Applications</strong>.</p>
          <a class="file" {...download('mac')} data-again>Download <code>{files.mac}</code></a>
          <p class="or">Or install it with Homebrew, which also puts the <code>localhost</code> command in your terminal:</p>
          <div class="copy-command">
            <code>{brewInstall}</code>
            <button type="button" data-copy={brewInstall} data-track="install_command_copied" data-track-command="brew">Copy</button>
          </div>
          {release.mac !== releases && (
            <>
              <p class="or">Or download it from Terminal, which macOS doesn’t block, so you can skip step 2:</p>
              <div class="copy-command">
                <code>{curl}</code>
                <button type="button" data-copy={curl} data-track="install_command_copied" data-track-command="curl">Copy</button>
              </div>
            </>
          )}
        </div>
      </li>
      <li class="step">
        <span class="number" aria-hidden="true">2</span>
        <div>
          <h3>Open it the first time</h3>
          <p>localhost isn’t notarized by Apple yet, so macOS blocks the first launch once:</p>
          <ol class="substeps">
            <li>Click <strong>Done</strong> in the warning.</li>
            <li>Open <strong>System Settings › Privacy &amp; Security</strong> and scroll to <strong>Security</strong>.</li>
            <li>Click <strong>Open Anyway</strong>, and confirm with your password or Touch ID.</li>
          </ol>
          <p class="or">Or run this in Terminal, then open localhost:</p>
          <div class="copy-command">
            <code>xattr -dr com.apple.quarantine /Applications/localhost.app</code>
            <button type="button" data-copy="xattr -dr com.apple.quarantine /Applications/localhost.app" data-track="install_command_copied" data-track-command="xattr">Copy</button>
          </div>
        </div>
      </li>
    </ol>
    <p class="needs"><span class="check" aria-hidden="true"></span>macOS 15 or later · Apple silicon or Intel</p>
  </section>

  <section data-panel="windows">
    <ol class="steps">
      <li class="step first">
        <span class="number" aria-hidden="true">1</span>
        <div>
          <h3>Run the installer</h3>
          <p>Open <code>{files.windows}</code>. It installs for your user only, no administrator rights needed.</p>
          <a class="file" {...download('windows')} data-again>Download <code>{files.windows}</code></a>
        </div>
      </li>
      <li class="step">
        <span class="number" aria-hidden="true">2</span>
        <div>
          <h3>Get past SmartScreen</h3>
          <p>The installer isn’t signed by a known publisher yet, so Windows says “Windows protected your PC”:</p>
          <ol class="substeps">
            <li>Click <strong>More info</strong>.</li>
            <li>Check that the file is <code>{files.windows}</code>.</li>
            <li>Click <strong>Run anyway</strong>.</li>
          </ol>
        </div>
      </li>
    </ol>
    <p class="needs"><span class="check" aria-hidden="true"></span>Windows 10 or 11 · x64 · WSL 2 for Projects in WSL</p>
  </section>

  <section data-panel="linux">
    <ol class="steps">
      <li class="step first">
        <span class="number" aria-hidden="true">1</span>
        <div>
          <h3>Download your package</h3>
          <div class="packages">
            <a class="package" {...download('deb')}><strong>Ubuntu, Debian</strong><code>.deb</code></a>
            <a class="package" {...download('rpm')}><strong>Fedora</strong><code>.rpm</code></a>
            <a class="package" {...download('appImage')}><strong>Any distro</strong><code>AppImage</code></a>
          </div>
        </div>
      </li>
      <li class="step">
        <span class="number" aria-hidden="true">2</span>
        <div>
          <h3>Install it</h3>
          <p>From the folder you downloaded it to:</p>
          <div class="copy-command">
            <code>sudo apt install ./{files.deb}</code>
            <button type="button" data-copy={`sudo apt install ./${files.deb}`} data-track="install_command_copied" data-track-command="apt">Copy</button>
          </div>
          <div class="copy-command">
            <code>sudo dnf install ./{files.rpm}</code>
            <button type="button" data-copy={`sudo dnf install ./${files.rpm}`} data-track="install_command_copied" data-track-command="dnf">Copy</button>
          </div>
          <div class="copy-command">
            <code>chmod +x {files.appImage} &amp;&amp; ./{files.appImage}</code>
            <button type="button" data-copy={`chmod +x ${files.appImage} && ./${files.appImage}`} data-track="install_command_copied" data-track-command="appimage">Copy</button>
          </div>
          <p class="or">
            Secrets need a Secret Service (GNOME Keyring, KWallet). On stock GNOME the tray icon needs the <a href={href('docs/linux')}>AppIndicator extension</a>.
          </p>
        </div>
      </li>
    </ol>
    <p class="needs"><span class="check" aria-hidden="true"></span>x86_64 · Ubuntu 22.04+ · Debian 12+ · Fedora</p>
  </section>

  <p class="other">
    <span>On another system?</span>
    <button type="button" data-other="macos">macOS</button>
    <button type="button" data-other="windows">Windows</button>
    <button type="button" data-other="linux">Linux</button>
    <a href={href('docs/install')}>Install guide →</a>
  </p>
</dialog>

<script>
  import type { Platform } from '../lib/release';
  import { names } from '../lib/platform';

  const dialog = document.querySelector<HTMLDialogElement>('[data-install]')!;
  const sub = dialog.querySelector<HTMLElement>('[data-sub]')!;

  // One platform at a time, the visitor's own; the others are a click away below.
  function show(platform: Platform) {
    dialog.querySelector('[data-platform-name]')!.textContent = `for ${names[platform]}`;
    for (const panel of dialog.querySelectorAll<HTMLElement>('[data-panel]')) panel.hidden = panel.dataset.panel !== platform;
    for (const other of dialog.querySelectorAll<HTMLElement>('[data-other]')) other.hidden = other.dataset.other === platform;
  }

  document.addEventListener('install:open', (event) => {
    const { platform, started } = (event as CustomEvent<{ platform: Platform; started: boolean }>).detail;
    sub.textContent = started ? 'Your download has started. Two quick steps, usually under a minute.' : 'Two quick steps, usually under a minute.';
    for (const link of dialog.querySelectorAll<HTMLElement>('[data-again]')) {
      link.firstChild!.textContent = started ? 'Download again ' : 'Download ';
    }
    show(platform);
    dialog.showModal();
  });

  dialog.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    // A click on the backdrop lands on the dialog itself.
    if (target === dialog || target.closest('[data-close]')) dialog.close();
    const other = target.closest<HTMLElement>('[data-other]');
    if (other) {
      // Moving away from the platform whose download started: the subtitle no longer applies.
      sub.textContent = 'Two quick steps, usually under a minute.';
      show(other.dataset.other as Platform);
    }
    const copy = target.closest<HTMLButtonElement>('[data-copy]');
    if (copy) {
      navigator.clipboard.writeText(copy.dataset.copy!).then(() => {
        copy.textContent = 'Copied';
        setTimeout(() => (copy.textContent = 'Copy'), 1500);
      });
    }
  });

</script>

<style>
  /* A screwed plate over the page. The screw heads are its background rather than a .screws span, so
   * they stay in the corners while a long platform's steps scroll. */
  .install {
    --head: radial-gradient(circle at 50% 50%, var(--screw) 0 3.5px, color-mix(in srgb, var(--screw) 60%, #000) 4px, transparent 4.5px);
    width: min(580px, calc(100vw - 24px));
    max-height: calc(100dvh - 32px);
    padding: 34px 34px 26px;
    border: 0;
    border-radius: 14px;
    background:
      var(--head) left 10px top 10px / 10px 10px no-repeat,
      var(--head) right 10px top 10px / 10px 10px no-repeat,
      var(--head) left 10px bottom 10px / 10px 10px no-repeat,
      var(--head) right 10px bottom 10px / 10px 10px no-repeat,
      var(--page-raised);
    color: var(--text);
    box-shadow:
      inset 0 1px 0 var(--plate-light),
      0 1px 0 var(--plate-edge),
      0 30px 70px -20px rgb(0 0 0 / 0.6);
    overflow-y: auto;
  }
  .install[open] {
    animation: enter 220ms var(--ease-out);
  }
  .install::backdrop {
    background: rgb(0 0 0 / 0.55);
  }
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .install[open] {
      animation-name: fade;
    }
    @keyframes fade {
      from {
        opacity: 0;
      }
    }
  }
  @media (max-width: 520px) {
    .install {
      padding: 30px 20px 20px;
    }
  }
  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  h2 {
    font-size: clamp(30px, 6vw, 40px);
  }
  h2 span {
    color: var(--text-secondary);
  }
  .close {
    flex: none;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 7px;
    background: var(--page-raised);
    color: var(--text-secondary);
    box-shadow:
      inset 0 1px 0 var(--plate-light),
      0 1px 2px rgb(0 0 0 / 0.3);
    cursor: pointer;
  }
  .close:hover {
    color: var(--text);
  }
  .close:active {
    transform: translateY(1px);
  }
  .sub {
    margin: 10px 0 22px;
    color: var(--text-secondary);
    font-size: 15px;
  }

  /* Steps read down the plate, each numbered on ink tape. */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--separator);
  }
  .step {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--separator);
  }
  .step > div {
    min-width: 0;
  }
  .number {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 3px;
    background: var(--text);
    color: var(--page);
    font: 800 18px/1 var(--font-display);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      0 1px 1px rgb(0 0 0 / 0.25);
  }
  /* On a phone the number sits beside the title and the step takes the full width under it. */
  @media (max-width: 520px) {
    .step {
      display: block;
    }
    .number {
      float: left;
      margin-right: 12px;
    }
  }
  h3 {
    margin: 2px 0 8px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 21px;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .step p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .step strong {
    color: var(--text);
    font-weight: 600;
  }
  .step code {
    font-size: 0.9em;
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--fill);
    overflow-wrap: anywhere;
  }
  .substeps {
    margin: 10px 0 0;
    padding-left: 20px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .substeps li + li {
    margin-top: 4px;
  }
  .substeps li::marker {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .step .or {
    margin-top: 14px;
    font-size: 13.5px;
  }
  .or a {
    color: var(--accent-text);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .file {
    display: inline-block;
    margin-top: 12px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-text);
    text-underline-offset: 3px;
  }
  .file code {
    color: inherit;
    background: none;
    padding: 0;
    font-weight: 500;
  }
  .copy-command {
    margin-top: 8px;
  }
  .step .copy-command code {
    padding: 0;
    background: none;
    color: var(--text);
    font-size: 12.5px;
  }
  .copy-command button:hover {
    color: var(--accent-text);
  }

  /* The packages are keys on the plate: raised, and lit in the accent under the pointer. */
  .packages {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 6px;
  }
  .package {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px;
    border-radius: 8px;
    background: var(--page-raised);
    box-shadow:
      inset 0 1px 0 var(--plate-light),
      0 1px 0 var(--plate-edge),
      0 2px 5px rgb(0 0 0 / 0.16);
    font-size: 13.5px;
    text-decoration: none;
    transition: box-shadow 150ms ease;
  }
  .package:hover {
    box-shadow:
      inset 0 1px 0 var(--plate-light),
      0 0 0 1.5px var(--accent);
  }
  .package:active {
    transform: translateY(1px);
  }
  .step .package code {
    align-self: flex-start;
    color: var(--text-secondary);
  }
  @media (max-width: 520px) {
    .packages {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .needs {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 16px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
  }
  .check {
    flex: none;
    position: relative;
    width: 14px;
    height: 14px;
  }
  .check::after {
    content: '';
    position: absolute;
    left: 2px;
    top: 2.5px;
    width: 9px;
    height: 5px;
    border: solid var(--text-secondary);
    border-width: 0 0 2px 2px;
    transform: rotate(-45deg);
  }

  /* The other platforms, as switches in a row under a plate label. */
  .other {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 22px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--separator);
  }
  .other span {
    margin-right: 4px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    text-shadow: 0 1px 0 var(--engrave-light);
  }
  .other button {
    height: 30px;
    padding: 0 12px;
    border: 0;
    border-radius: 6px;
    background: var(--page-raised);
    color: var(--text);
    font: 600 15px/1 var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow:
      inset 0 1px 0 var(--plate-light),
      0 1px 0 var(--plate-edge),
      0 1px 3px rgb(0 0 0 / 0.18);
    cursor: pointer;
  }
  .other button:hover {
    color: var(--accent-text);
  }
  .other button:active {
    transform: translateY(1px);
  }
  .other button[hidden] {
    display: none;
  }
  .other a {
    margin-left: auto;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-text);
    text-decoration: none;
  }
  .other a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
