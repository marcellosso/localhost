---
/* The localhost window, drawn in HTML so it stays sharp and can run: Start All
 * brings the Acme Shop Project up in dependency order, as the app does. */
const services = [
  { key: 'migrate', name: 'Migrations', command: 'pnpm db:migrate', colour: 0 },
  { key: 'api', name: 'API', port: 8000, command: 'python3 server.py --port $PORT', colour: 1 },
  { key: 'web', name: 'Web', port: 5173, command: 'pnpm dev --port $PORT', colour: 2 },
  { key: 'worker', name: 'Worker', command: 'pnpm dev', colour: 3 },
  { key: 'storybook', name: 'Storybook', port: 6006, command: 'pnpm storybook --port $PORT', colour: 4, manual: true },
];
---

<figure class="figure">
  <div class="window" data-app-window>
    <aside class="sidebar" aria-hidden="true">
      <div class="lights"><span></span><span></span><span></span></div>
      <div class="brand">localhost<span>:</span></div>
      <div class="search">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="7" cy="7" r="4.5"></circle><path d="m10.5 10.5 3 3" stroke-linecap="round"></path></svg>
        Search projects
      </div>
      <div class="nav-row">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="var(--link)" stroke-width="1.5"><circle cx="8" cy="8" r="6"></circle><path d="M2 8h12M8 2c2 2 2 10 0 12M8 2c-2 2-2 10 0 12"></path></svg>
        Ports
      </div>
      <div class="group">Projects</div>
      <div class="project selected"><span class="dot" data-project-dot></span>Acme Shop<span class="star">★</span></div>
      <div class="project"><span class="dot"></span>Blog</div>
      <div class="project"><span class="dot"></span>Design System</div>
      <div class="sidebar-footer">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="2.25"></circle><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"></path></svg>
        <span class="mono" data-running-total>0 running</span>
      </div>
    </aside>

    <div class="main">
      <div class="toolbar">
        <div class="title" aria-hidden="true">
          <strong>Acme Shop</strong>
          <span class="mono">~/Code/acme-shop</span>
        </div>
        <div class="profile" aria-hidden="true">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="m8 2 6 3-6 3-6-3 6-3Z M2 8l6 3 6-3M2 11l6 3 6-3" stroke-linejoin="round"></path></svg>
          Development
        </div>
        <button type="button" class="tool start" data-start-all>
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1v8l7-4z" fill="currentColor"></path></svg>
          Start All
        </button>
        <button type="button" class="tool stop" data-stop-all disabled>
          <svg width="9" height="9" viewBox="0 0 9 9" aria-hidden="true"><rect width="9" height="9" rx="1.5" fill="currentColor"></rect></svg>
          Stop All
        </button>
      </div>

      <div class="panes" aria-hidden="true">
        <div class="services">
          <div class="all">
            <span class="dots"><i></i><i></i><i></i><i></i></span>
            All services
            <span class="count mono" data-running-count>0 of 5</span>
          </div>
          {
            services.map((service) => (
              <div class="row" data-service={service.key} data-manual={service.manual ? '' : undefined} style={`--service: var(--service-${service.colour})`}>
                <span class="bar" />
                <span class="glyph" data-glyph data-state="stopped" />
                <span class="name">{service.name}</span>
                {service.port && <span class="port mono">:{service.port}</span>}
                <span class="state" data-state-label>{service.manual ? 'Manual' : 'Stopped'}</span>
                <code class="command">{service.command}</code>
              </div>
            ))
          }
          <div class="add">
            <span>+ Add Service</span>
            <kbd>⇧⌘N</kbd>
          </div>
        </div>

        <div class="log">
          <div class="log-header">
            <span class="dots"><i></i><i></i><i></i><i></i></span>
            <strong>All services</strong>
            <span class="muted" data-running-summary>0 of 5 running</span>
            <span class="filter">Filter <kbd>⌘F</kbd></span>
          </div>
          <div class="lines" data-log>
            <div class="empty" data-empty>Press Start All to run every Service <kbd>⇧⌘R</kbd></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="visually-hidden">
    The localhost window with the Acme Shop Project. Start All runs Migrations first, then starts API, Web and Worker, and
    their output appears in one merged log, each line prefixed with its Service's Key.
  </figcaption>
</figure>

<script>
  type State = 'stopped' | 'starting' | 'running' | 'stopping' | 'exited';

  const root = document.querySelector<HTMLElement>('[data-app-window]')!;
  const log = root.querySelector<HTMLElement>('[data-log]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  const startButton = root.querySelector<HTMLButtonElement>('[data-start-all]')!;
  const stopButton = root.querySelector<HTMLButtonElement>('[data-stop-all]')!;
  const instant = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const colour: Record<string, number> = { migrate: 0, api: 1, web: 2, worker: 3, storybook: 4 };
  const states = new Map<string, State>();
  let generation = 0;
  let visible = false;

  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, instant ? 0 : ms));

  function setState(key: string, state: State) {
    states.set(key, state);
    const row = root.querySelector<HTMLElement>(`[data-service="${key}"]`)!;
    row.querySelector<HTMLElement>('[data-glyph]')!.dataset.state = state;
    const labels: Record<State, string> = {
      stopped: row.hasAttribute('data-manual') ? 'Manual' : 'Stopped',
      starting: 'Starting',
      running: 'Running',
      stopping: 'Stopping',
      exited: 'Exited · code 0',
    };
    row.querySelector<HTMLElement>('[data-state-label]')!.textContent = labels[state];
    refresh();
  }

  function refresh() {
    const running = [...states.values()].filter((state) => state === 'running').length;
    const active = [...states.values()].some((state) => state === 'running' || state === 'starting');
    root.querySelector('[data-running-count]')!.textContent = `${running} of 5`;
    root.querySelector('[data-running-summary]')!.textContent = `${running} of 5 running`;
    root.querySelector('[data-running-total]')!.textContent = `${running} running`;
    root.querySelector<HTMLElement>('[data-project-dot]')!.classList.toggle('on', running > 0);
    stopButton.disabled = !active;
  }

  function line(key: string, html: string) {
    empty.remove();
    const row = document.createElement('div');
    row.className = 'line';
    row.innerHTML = `<span class="key" style="color: var(--service-${colour[key]})">${key}</span><span>${html}</span>`;
    log.append(row);
    while (log.children.length > 60) log.firstElementChild!.remove();
  }

  const clock = () => new Date().toTimeString().slice(0, 8);
  const requests = [
    () => ['api', `<i class="g">INFO</i>:     127.0.0.1:${50000 + Math.floor(Math.random() * 9999)} - "POST /api/cart HTTP/1.1" <i class="g">200 OK</i>`],
    () => ['api', `<i class="g">INFO</i>:     127.0.0.1:${50000 + Math.floor(Math.random() * 9999)} - "GET /api/products/42 HTTP/1.1" <i class="g">200 OK</i>`],
    () => ['web', `<i class="d">${clock()}</i> <i class="c">[vite]</i> hmr update <i class="d">/src/routes/cart.tsx</i>`],
    () => ['web', `<i class="d">${clock()}</i> <i class="c">[vite]</i> hmr update <i class="d">/src/components/ProductCard.tsx</i>`],
    () => ['worker', `<i class="d">${new Date().toISOString()}</i> <i class="y">emails</i> done order-confirmation #${1040 + Math.floor(Math.random() * 60)} ${120 + Math.floor(Math.random() * 90)}ms`],
    () => ['worker', `<i class="d">${new Date().toISOString()}</i> <i class="y">thumbnails</i> done product 42 (3 sizes) ${90 + Math.floor(Math.random() * 40)}ms`],
  ];

  async function startAll() {
    if (['migrate', 'api', 'web', 'worker'].every((key) => states.get(key) === 'running' || states.get(key) === 'exited')) return;
    const run = ++generation;
    const live = () => run === generation;

    // API, Web and Worker wait for Migrations, their Dependency.
    for (const key of ['migrate', 'api', 'web', 'worker']) setState(key, 'starting');
    await sleep(350);
    for (const name of ['0001_create_products', '0002_create_orders', '0003_add_cart_items', '0004_index_orders_by_customer']) {
      if (!live()) return;
      line('migrate', `<i class="g">✔</i> ${name} <i class="d">applied</i>`);
      await sleep(160);
    }
    if (!live()) return;
    line('migrate', '4 migrations applied in 0.61s');
    line('migrate', '<i class="d it">Exited with code 0</i>');
    setState('migrate', 'exited');

    await sleep(300);
    if (!live()) return;
    line('api', `<i class="g">INFO</i>:     Will watch for changes in these directories: ['~/Code/acme-shop/api']`);
    line('worker', 'worker ready, polling <i class="y">queue:emails</i> and <i class="y">queue:thumbnails</i>');
    setState('worker', 'running');
    await sleep(380);
    if (!live()) return;
    line('api', `<i class="g">INFO</i>:     Uvicorn running on <i class="u">http://127.0.0.1:8000</i> (Press CTRL+C to quit)`);
    line('api', `<i class="g">INFO</i>:     Application startup complete.`);
    setState('api', 'running');
    await sleep(420);
    if (!live()) return;
    line('web', '');
    line('web', '  <b class="g">VITE</b> <i class="g">v6.2.0</i>  ready in <b>412</b> ms');
    line('web', '');
    line('web', '  <i class="g">➜</i>  <b>Local</b>:   <i class="u">http://localhost:5173/</i>');
    line('web', '  <i class="g">➜</i>  <b>Network</b>: use <b>--host</b> to expose');
    setState('web', 'running');

    if (instant) return;
    while (live()) {
      await sleep(900 + Math.random() * 1400);
      if (!live()) return;
      if (!visible || document.hidden) continue;
      const [key, html] = requests[Math.floor(Math.random() * requests.length)]();
      line(key, html);
    }
  }

  async function stopAll() {
    const run = ++generation;
    const active = ['worker', 'web', 'api'].filter((key) => states.get(key) === 'running' || states.get(key) === 'starting');
    if (states.get('migrate') === 'starting') active.push('migrate');
    for (const key of active) setState(key, 'stopping');
    await sleep(700);
    if (run !== generation) return;
    for (const key of active) setState(key, 'stopped');
  }

  for (const key of Object.keys(colour)) states.set(key, 'stopped');
  startButton.addEventListener('click', () => startAll());
  stopButton.addEventListener('click', () => stopAll());

  let started = false;
  new IntersectionObserver(
    ([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !started) {
        started = true;
        setTimeout(startAll, instant ? 0 : 700);
      }
    },
    { threshold: 0.3 },
  ).observe(root);
</script>

<style>
  .figure {
    margin: 0;
  }
  .window {
    display: grid;
    grid-template-columns: 210px 1fr;
    height: 540px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow);
    font-size: 13px;
    line-height: 1.35;
    color: var(--text);
    text-align: left;
    -webkit-user-select: none;
    user-select: none;
  }
  .mono,
  .command,
  .port,
  .count {
    font-family: var(--font-mono);
  }

  /* Glass steps down left to right: sidebar most translucent, log opaque. */
  .sidebar {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 10px;
    background: color-mix(in srgb, var(--surface-sidebar) 72%, transparent);
    backdrop-filter: blur(30px) saturate(1.6);
    -webkit-backdrop-filter: blur(30px) saturate(1.6);
    border-right: 1px solid var(--separator);
  }
  .main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: color-mix(in srgb, var(--surface-column) 90%, transparent);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
  }
  @media (prefers-reduced-transparency: reduce) {
    .sidebar {
      background: var(--surface-sidebar);
    }
    .main {
      background: var(--surface-column);
    }
  }
  .lights {
    display: flex;
    gap: 8px;
    padding: 2px 4px 14px;
  }
  .lights span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .lights span:nth-child(2) {
    background: #febc2e;
  }
  .lights span:nth-child(3) {
    background: #28c840;
  }
  .brand {
    font: 600 17px/1 var(--font-mono);
    padding: 0 6px 12px;
  }
  .brand span {
    color: var(--accent);
  }
  .search {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 8px;
    margin-bottom: 8px;
    border-radius: 7px;
    background: var(--fill);
    color: var(--text-tertiary);
    font-size: 12px;
  }
  .nav-row,
  .project {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 8px;
    border-radius: 7px;
  }
  .group {
    padding: 14px 8px 4px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-tertiary);
  }
  .project.selected {
    background: var(--fill-strong);
  }
  .project .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--state-stopped);
  }
  .project .dot:global(.on) {
    border: 0;
    background: var(--state-running);
  }
  .star {
    margin-left: auto;
    color: var(--text-tertiary);
    font-size: 11px;
  }
  .sidebar-footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 6px;
    color: var(--text-tertiary);
    font-size: 11px;
  }

  .toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 52px;
    padding: 0 12px 0 16px;
    border-bottom: 1px solid var(--separator);
  }
  .title {
    display: flex;
    flex-direction: column;
    margin-right: auto;
    min-width: 0;
  }
  .title strong {
    font-size: 13px;
  }
  .title span {
    font-size: 11px;
    color: var(--text-tertiary);
  }
  .profile,
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 10px;
    border-radius: 7px;
    font: 600 12px/1 var(--font-sans);
    white-space: nowrap;
  }
  .profile {
    color: var(--text-secondary);
    box-shadow: inset 0 0 0 1px var(--separator);
    font-weight: 500;
  }
  .tool {
    border: 0;
    cursor: pointer;
    transition:
      transform 140ms var(--ease-out),
      opacity 140ms ease;
  }
  .tool:active:not(:disabled) {
    transform: scale(0.96);
  }
  .tool:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .start {
    background: var(--accent);
    color: var(--on-accent);
  }
  .stop {
    background: var(--fill-strong);
    color: var(--text);
  }

  .panes {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(240px, 300px) 1fr;
    min-height: 0;
  }
  .services {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px;
    border-right: 1px solid var(--separator);
  }
  .all {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 10px;
    border-radius: 7px;
    background: var(--fill-strong);
    font-weight: 600;
  }
  .dots {
    display: grid;
    grid-template-columns: repeat(2, 4px);
    gap: 2px;
  }
  .dots i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--service-0);
  }
  .dots i:nth-child(2) {
    background: var(--service-1);
  }
  .dots i:nth-child(3) {
    background: var(--service-2);
  }
  .dots i:nth-child(4) {
    background: var(--service-3);
  }
  .count {
    margin-left: auto;
    font-size: 11px;
    font-weight: 400;
    color: var(--text-tertiary);
  }
  .row {
    display: grid;
    grid-template-columns: 3px 12px auto auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 8px;
    row-gap: 3px;
    align-items: center;
    padding: 8px 10px 8px 6px;
    border-radius: 7px;
  }
  .bar {
    grid-row: 1 / 3;
    align-self: stretch;
    border-radius: 2px;
    background: var(--service);
  }
  .name {
    font-weight: 600;
  }
  .port {
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 11px;
    color: var(--service);
    background: color-mix(in srgb, var(--service) 16%, transparent);
  }
  .state {
    grid-column: 5;
    justify-self: end;
    font-size: 11px;
    color: var(--text-tertiary);
    white-space: nowrap;
  }
  .row:not(:has(.port)) .state {
    grid-column: 4 / 6;
  }
  .command {
    grid-column: 3 / 6;
    font-size: 11.5px;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* State glyphs carry state by shape. */
  .glyph {
    width: 9px;
    height: 9px;
    justify-self: center;
    border-radius: 50%;
    border: 1.5px solid var(--state-stopped);
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }
  .glyph[data-state='running'] {
    border-color: transparent;
    background: var(--state-running);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--state-running) 25%, transparent);
  }
  .glyph[data-state='starting'],
  .glyph[data-state='stopping'] {
    border: 2px solid var(--state-transitioning);
    animation: pulse 1s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      transform: scale(0.75);
      opacity: 0.6;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .glyph[data-state='starting'],
    .glyph[data-state='stopping'] {
      animation: none;
    }
  }

  .add {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 10px;
    color: var(--text-secondary);
    font-size: 12px;
  }
  .add kbd,
  .filter kbd,
  .empty kbd {
    height: 18px;
    min-width: 0;
    font-size: 10.5px;
  }

  .log {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--surface-log);
  }
  .log-header {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 12px;
    border-bottom: 1px solid var(--separator);
    font-size: 12px;
  }
  .muted {
    color: var(--text-tertiary);
  }
  .filter {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 4px 0 8px;
    border-radius: 6px;
    background: var(--fill);
    color: var(--text-tertiary);
    font-size: 11px;
  }
  .lines {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    padding: 10px 0 12px;
    font: 12px/1.5 var(--font-mono);
    white-space: pre;
  }
  .empty {
    margin: auto;
    display: flex;
    gap: 8px;
    align-items: center;
    font-family: var(--font-sans);
    color: var(--text-tertiary);
    white-space: normal;
  }
  .lines :global(.line) {
    display: grid;
    grid-template-columns: 72px 1fr;
    padding: 0 12px;
    min-height: 18px;
    animation: appear 240ms var(--ease-out);
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
  }
  .lines :global(.key) {
    font-weight: 600;
  }
  .lines :global(.line > span:last-child) {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lines :global(i),
  .lines :global(b) {
    font-style: normal;
  }
  .lines :global(.g) {
    color: var(--ansi-2);
  }
  .lines :global(.y) {
    color: var(--ansi-3);
  }
  .lines :global(.c) {
    color: var(--ansi-6);
  }
  .lines :global(.d) {
    color: var(--text-tertiary);
  }
  .lines :global(.it) {
    font-style: italic;
  }
  .lines :global(.u) {
    color: var(--link);
    text-decoration: underline;
  }

  @media (max-width: 960px) {
    .window {
      grid-template-columns: 1fr;
    }
    .sidebar {
      display: none;
    }
  }
  @media (max-width: 680px) {
    .window {
      height: auto;
    }
    .panes {
      grid-template-columns: 1fr;
    }
    .services {
      border-right: 0;
      border-bottom: 1px solid var(--separator);
    }
    .add,
    .profile,
    .title span {
      display: none;
    }
    .lines {
      height: 260px;
      flex: none;
    }
  }
</style>
