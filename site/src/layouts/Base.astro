---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InstallDialog from '../components/InstallDialog.astro';
import { href, name } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** `article` for docs and changelog pages, which read as documents. */
  type?: 'website' | 'article';
  /** schema.org objects for this page, written as JSON-LD. */
  structuredData?: Record<string, unknown>[];
  /** Kept out of search results (the 404 page). */
  noindex?: boolean;
}
const { title, description, type = 'website', structuredData = [], noindex = false } = Astro.props;
const fullTitle = title === name ? 'localhost app: desktop process manager for local dev servers' : `${title} · ${name}`;
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1').replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site).toString();
const image = new URL('/og.png', Astro.site).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href={href('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    <link rel="manifest" href={href('site.webmanifest')} />
    <link rel="sitemap" href={href('sitemap.xml')} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0c0c0f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />

    <meta property="og:site_name" content={name} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="The localhost app icon and window, with the words: Every local project, one place to run it." />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...data })} />)}
    <script is:inline>
      // Dark unless the visitor picked light, applied before the first paint.
      document.documentElement.dataset.theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark';
    </script>
    {
      // Vercel Web Analytics, without its npm package: Vercel serves the script
      // from the deployment itself, so it only exists in production builds there.
      import.meta.env.PROD && (
        <>
          <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
          <script is:inline defer src="/_vercel/insights/script.js"></script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip visually-hidden" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <InstallDialog />
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 12px;
    left: 12px;
    width: auto;
    height: auto;
    clip: auto;
    z-index: 100;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--page-raised);
    box-shadow: var(--ring-strong);
  }
</style>
