---
import Base from '../layouts/Base.astro';
import AppWindow from '../components/AppWindow.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { brewInstall, href, name, releases, repository, tagline } from '../lib/site';
import { definition, faq, html, plain } from '../lib/faq';
import { changelog } from '../lib/changelog';
import { latestRelease } from '../lib/release';

const release = await latestRelease();
const description =
  'localhost app: free, open-source desktop process manager for local dev servers on macOS, Windows and Linux, with an MCP server for Claude Code, Cursor and Codex.';
const alternateName = ['localhost app', 'getlocalhost'];
const structuredData = [
  { '@type': 'WebSite', name, alternateName, url: Astro.site!.toString(), description: tagline },
  {
    '@type': 'SoftwareApplication',
    name,
    alternateName,
    description: definition,
    url: Astro.site!.toString(),
    image: new URL('/og.png', Astro.site).toString(),
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS 15 or later, Windows 10 or 11, Linux',
    ...(release.version === '<version>' ? {} : { softwareVersion: release.version }),
    downloadUrl: releases,
    featureList: [
      'Start, stop and restart dev servers, workers and databases from one window',
      'Start All in dependency order, with one merged log',
      'Services counted as Running once their Port accepts connections',
      'A Ports view of every process listening on a TCP port',
      'Variables, Environment Profiles and Secrets in the system’s secret store',
      'Services suggested from package.json, Compose files, Python apps and Cargo binaries',
      'An MCP server (localhost mcp) for Claude Code, Cursor, Codex and other coding agents',
      'In-app updates that stop running Services only after asking',
      'Projects on Windows itself or in a WSL 2 distro',
      'A command palette and a keyboard shortcut for every action',
    ],
    license: 'https://opensource.org/licenses/MIT',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    codeRepository: repository,
    author: {
      '@type': 'Person',
      name: 'Marcel Losso',
      url: 'https://github.com/marcellosso',
      sameAs: ['https://github.com/marcellosso', 'https://x.com/marcellosso'],
    },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer.map(plain).join('\n\n') },
    })),
  },
];

const latest = (await changelog()).find((entry) => entry.released);

const commands = [
  { runtime: 'Node', command: 'pnpm dev' },
  { runtime: 'Bun', command: 'bun run dev' },
  { runtime: 'Python', command: 'uv run fastapi dev' },
  { runtime: 'Rust', command: 'cargo run' },
  { runtime: 'Compose', command: 'docker compose up postgres' },
  { runtime: 'Anything', command: './bin/dev --port $PORT' },
];

const pillars = [
  { title: 'No account', text: 'No sign-in and no backend. Works offline, on your machine only.' },
  { title: 'Nothing in your repo', text: 'Configuration lives in localhost’s own storage. Export a Project file when you want to share one.' },
  { title: 'Nothing silent', text: 'No automatic restarts, and no Suggestion applied until you check it.' },
  { title: 'Native everywhere', text: 'SwiftUI on macOS, one light app for Linux and Windows, all on one Rust core.' },
];
---

<Base title={name} {description} {structuredData}>
  <section class="hero">
    <div class="container">
      <div class="hero-copy">
        {
          latest && (
            <a class="pill" href={href('changelog')}>
              <span class="mono">v{latest.version}</span>
              {latest.title}
              <span aria-hidden="true">→</span>
            </a>
          )
        }
        <h1 class="display headline">Every local project,<br /> one place to run it.</h1>
        <p class="lede hero-lede">
          localhost remembers how each of your projects runs. Pick a Project, press Start All and watch every Service come up, instead of
          keeping a row of terminal tabs alive.
        </p>
        <div class="ctas">
          <DownloadButton location="hero" />
          <a class="button button-secondary" href={repository} data-track="github_clicked" data-track-location="hero">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"></path></svg>
            View on GitHub
          </a>
        </div>
        <p class="platforms">
          Free, open-source desktop process manager for your local dev servers on <a href={href('docs/install')}>macOS, Windows and Linux</a>.
          A GUI alternative to pm2 and tmux.
        </p>
        <p class="brew">On macOS, also with <a href={href('docs/install#homebrew-macos')}>Homebrew</a>: <code>{brewInstall}</code></p>
      </div>
      <div class="stage">
        <div class="glow" aria-hidden="true"></div>
        <AppWindow />
        <p class="hint">It’s live: pick a Project, a Service or Ports, and start or stop anything.</p>
      </div>
    </div>
  </section>

  <section class="feature">
    <div class="container">
      <div class="feature-head">
        <p class="figure-label">Fig 01 · Commands</p>
        <h2 class="display section-title">If it runs in your terminal, it runs here.</h2>
        <p class="lede">
          A Service is a folder, a command line and its environment. localhost runs it in your login shell, so your <code>PATH</code>,
          version managers and profile all apply.
        </p>
      </div>
      <div class="commands">
        {
          commands.map((item) => (
            <div class="command-cell">
              <span class="runtime">{item.runtime}</span>
              <code>{item.command}</code>
            </div>
          ))
        }
      </div>
      <ul class="checks">
        <li>Runs as <code>$SHELL -l -c</code>, so pipes and <code>&amp;&amp;</code> work</li>
        <li>Gets its Port as <code>$PORT</code>; command lines are never rewritten</li>
        <li>Stop ends the whole process tree, every time</li>
      </ul>
    </div>
  </section>

  <section class="feature">
    <div class="container split">
      <div class="copy">
        <p class="figure-label">Fig 02 · Ports</p>
        <h2 class="display section-title">Know who’s on :3000. <span class="title-aside">Find which process is using a port.</span></h2>
        <p class="lede">
          A Service counts as Running once its Port accepts connections. If the Port is taken, localhost says by whom, and can start on
          the next free one for that Run only.
        </p>
        <a class="more" href={href('docs/ports')}>How Ports work →</a>
      </div>
      <div class="mock-stack" aria-hidden="true">
        <div class="mock ports">
          <div class="mock-title">Ports <span>5 listening</span></div>
          <div class="port-row"><code>:5432</code><span>postgres</span><span class="owner"><i style="--c: var(--service-0)"></i>Acme Shop › Database</span></div>
          <div class="port-row"><code>:8000</code><span>python3</span><span class="owner"><i style="--c: var(--service-1)"></i>Acme Shop › API</span></div>
          <div class="port-row"><code>:5173</code><span>node</span><span class="owner"><i style="--c: var(--service-2)"></i>Acme Shop › Web</span></div>
          <div class="port-row"><code>:3000</code><span>node</span><span class="owner faint">~/Code/blog</span></div>
          <div class="port-row"><code>:6379</code><span>redis-server</span><span class="owner faint">Unmanaged</span></div>
        </div>
        <div class="mock dialog">
          <strong>Port 3000 is taken</strong>
          <p><code>node</code> (pid 48211), running in <code>~/Code/blog</code>, is listening on it.</p>
          <div class="dialog-actions">
            <span class="fake secondary">Cancel</span>
            <span class="fake secondary">Start on 3001</span>
            <span class="fake primary">Stop it and start</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="feature">
    <div class="container split reverse">
      <div class="copy">
        <p class="figure-label">Fig 03 · Environment</p>
        <h2 class="display section-title">Environment without .env juggling.</h2>
        <p class="lede">
          Variables on the Project, on each Service and in Environment Profiles. Any of them can be a Secret, kept in Keychain, Secret
          Service or Credential Manager, never in a file.
        </p>
        <a class="more" href={href('docs/environment')}>Environment and Secrets →</a>
      </div>
      <div class="mock env" aria-hidden="true">
        <div class="mock-title">
          API's environment
          <span class="segmented"><b>Development</b><span>Testing</span></span>
        </div>
        <div class="env-row"><code>PATH</code><code class="value">~/.local/share/mise/shims:…</code><span class="from">login shell</span></div>
        <div class="env-row"><code>LOG_LEVEL</code><code class="value">debug</code><span class="from">Project</span></div>
        <div class="env-row"><code>DATABASE_URL</code><code class="value">postgres://localhost:5432/app</code><span class="from">Service</span></div>
        <div class="env-row secret">
          <code>STRIPE_KEY</code>
          <code class="value">
            <svg width="11" height="11" viewBox="0 0 16 16" fill="currentColor"><path d="M4 7V5a4 4 0 1 1 8 0v2h.5A1.5 1.5 0 0 1 14 8.5v5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5v-5A1.5 1.5 0 0 1 3.5 7H4Zm2 0h4V5a2 2 0 1 0-4 0v2Z"></path></svg>
            ••••••••••••
          </code>
          <span class="from">Secret</span>
        </div>
        <div class="env-row"><code>NODE_ENV</code><code class="value">development</code><span class="from">Development</span></div>
        <div class="env-row"><code>PORT</code><code class="value">8000</code><span class="from">Port</span></div>
      </div>
    </div>
  </section>

  <section class="feature">
    <div class="container split">
      <div class="copy">
        <p class="figure-label">Fig 04 · Suggestions</p>
        <h2 class="display section-title">Point it at a folder.</h2>
        <p class="lede">
          localhost reads <code>package.json</code> scripts, Compose files, Python apps and Cargo binaries, then suggests Services. You
          review every one, and nothing is applied silently.
        </p>
        <a class="more" href={href('docs/quick-start')}>Add your first Project →</a>
      </div>
      <div class="mock suggest" aria-hidden="true">
        <div class="mock-title">Add Project <code>~/Code/acme-shop</code></div>
        <div class="suggestion on"><span class="check"></span><b>Web</b><code>pnpm run dev</code><span class="src">web/package.json</span></div>
        <div class="suggestion on"><span class="check"></span><b>API</b><code>uv run fastapi dev --port $PORT</code><span class="src">api/pyproject.toml</span></div>
        <div class="suggestion on"><span class="check"></span><b>Database</b><code>docker compose up postgres</code><span class="src">compose.yaml</span></div>
        <div class="suggestion on"><span class="check"></span><b>Worker</b><code>pnpm run worker</code><span class="src">worker/package.json</span></div>
        <div class="folded">› 3 more found</div>
        <div class="dialog-actions">
          <span class="fake secondary">Cancel</span>
          <span class="fake primary">Add Project</span>
        </div>
      </div>
    </div>
  </section>

  <section class="feature">
    <div class="container split reverse">
      <div class="copy">
        <p class="figure-label">Fig 05 · Keyboard</p>
        <h2 class="display section-title">Keyboard first.</h2>
        <p class="lede">
          <kbd data-other="Ctrl+K">⌘K</kbd> jumps to any Project or Service and runs any action. Every action has a shortcut, and the
          arrow keys move across the window.
        </p>
        <a class="more" href={href('docs/keyboard')}>All shortcuts →</a>
      </div>
      <div class="mock palette" aria-hidden="true">
        <div class="query">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="7" cy="7" r="4.5"></circle><path d="m10.5 10.5 3 3" stroke-linecap="round"></path></svg>
          web<span class="caret"></span>
        </div>
        <div class="palette-group">Services</div>
        <div class="palette-row selected"><span class="glyph-running"></span>Web<span class="faint">Acme Shop</span><kbd>↵</kbd></div>
        <div class="palette-group">Actions</div>
        <div class="palette-row">Restart Web<kbd data-other="Ctrl+R">⌘R</kbd></div>
        <div class="palette-row">Stop Web<kbd data-other="Ctrl+.">⌘.</kbd></div>
        <div class="palette-row">Open Web in Browser<kbd data-other="Ctrl+Shift+O">⇧⌘O</kbd></div>
      </div>
    </div>
  </section>

  <section class="feature">
    <div class="container">
      <div class="feature-head">
        <p class="figure-label">Fig 06 · Local-first</p>
        <h2 class="display section-title">Your machine, your rules.</h2>
      </div>
      <div class="pillars">
        {
          pillars.map((pillar) => (
            <div class="pillar">
              <h3>{pillar.title}</h3>
              <p>{pillar.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="feature">
    <div class="container split">
      <div class="copy">
        <p class="figure-label">Fig 07 · Command line</p>
        <h2 class="display section-title">And from the terminal.</h2>
        <p class="lede">
          The <code>localhost</code> command runs on the same core and the same data: list Projects, see what is running, read the latest
          logs, or run a Project until Ctrl-C.
        </p>
        <a class="more" href={href('docs/cli')}>The command line →</a>
      </div>
      <div class="terminal" aria-hidden="true">
        <pre><span class="p">$</span> localhost status acme-shop
<b>Acme Shop</b> <span class="d">(acme-shop) · ~/Code/acme-shop</span>
SERVICE    NAME        STATE        PORT  PID    UP
migrate    Migrations  not running
api        API         running      8000  48211  2h 14m
web        Web         running      5173  48230  2h 14m
worker     Worker      running            48245  2h 14m
storybook  Storybook   not running  6006

<span class="p">$</span> localhost logs acme-shop web
<span class="d">web |</span>   <span class="g">VITE</span> v6.2.0  ready in 412 ms
<span class="d">web |</span>   <span class="g">➜</span>  Local:   http://localhost:5173/</pre>
      </div>
    </div>
  </section>

  <section class="feature">
    <div class="container split reverse">
      <div class="copy">
        <p class="figure-label">Fig 08 · Coding agents</p>
        <h2 class="display section-title">Your agent runs the same Services. <span class="title-aside">MCP for Claude Code, Cursor and Codex.</span></h2>
        <p class="lede">
          <code>localhost mcp</code> lets coding agents start, stop and read the logs and ports of your Services, instead of a
          <code>pnpm dev</code> in a shell you can’t see. What an agent starts shows in the window, it never starts a second copy, and it
          stops when the agent leaves, unless the app is open.
        </p>
        <ul class="checks">
          <li>One background core for the app and the agent</li>
          <li>Typed failures such as <code>portConflict</code></li>
          <li>An agent skill to make it the default</li>
        </ul>
        <a class="more" href={href('agents')}>localhost for coding agents →</a>
      </div>
      <div class="terminal" aria-hidden="true">
        <pre><span class="d">// a coding agent, through localhost mcp</span>
<span class="p">→</span> start_service <span class="d">{'{ project: "acme-shop", service: "web" }'}</span>
<span class="g">←</span> web   running  5173  <span class="d">startedBy:</span> agent
  api   running  8000  <span class="d">startedBy:</span> app

<span class="p">→</span> logs <span class="d">{'{ project: "acme-shop", service: "web", lines: 2 }'}</span>
<span class="g">←</span>   <span class="g">VITE</span> v6.2.0  ready in 412 ms
    <span class="g">➜</span>  Local:   http://localhost:5173/</pre>
      </div>
    </div>
  </section>

  <section class="feature">
    <div class="container split">
      <div class="copy">
        <p class="figure-label">Fig 09 · Updates</p>
        <h2 class="display section-title">Updates that ask first.</h2>
        <p class="lede">
          localhost checks for a new version at launch and every 6 hours, and offers it in the sidebar. Restart to Update stops your
          running Services first, after listing them. Updates are signed and checked before they install.
        </p>
        <ul class="checks">
          <li>The macOS app, AppImage and Windows installer update themselves</li>
          <li><code>.deb</code> and <code>.rpm</code> stay with your package manager</li>
          <li>Off with one switch in Settings</li>
        </ul>
        <a class="more" href={href('docs/updates')}>How updates work →</a>
      </div>
      <div class="mock-stack updates" aria-hidden="true">
        <div class="mock notice">
          <strong>A new version of localhost is available</strong>
          <div class="dialog-actions">
            <span class="notes">Release Notes</span>
            <span class="fake secondary">Later</span>
            <span class="fake primary">Update Now</span>
          </div>
        </div>
        <div class="mock dialog">
          <strong>Stop 2 services and update?</strong>
          <p>localhost restarts to install the new version. These services are stopped first:</p>
          <p>Acme Shop: API, Web</p>
          <div class="dialog-actions">
            <span class="fake secondary">Cancel</span>
            <span class="fake primary">Stop and Update</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="feature">
    <div class="container">
      <div class="feature-head">
        <p class="figure-label">Fig 10 · Platforms</p>
        <h2 class="display section-title">macOS, Windows and Linux.</h2>
        <p class="lede">One Rust core under every app, the command line and the MCP server, so a Project runs the same everywhere.</p>
      </div>
      <div class="platform-grid">
        <a class="platform" href={href('docs/macos')}>
          <h3>macOS</h3>
          <p>A native SwiftUI app with a menu bar companion, from the DMG or Homebrew. Secrets in the Keychain.</p>
          <span class="req">macOS 15 or later · Apple silicon or Intel</span>
        </a>
        <a class="platform" href={href('docs/windows')}>
          <h3>Windows</h3>
          <p>Projects on Windows itself, or inside a WSL 2 distro. Per-user install, no administrator rights.</p>
          <span class="req">Windows 10 or 11 · x64</span>
        </a>
        <a class="platform" href={href('docs/linux')}>
          <h3>Linux</h3>
          <p><code>.deb</code>, <code>.rpm</code> and AppImage, with a tray icon. Secrets in the Secret Service.</p>
          <span class="req">Ubuntu 22.04+ · Debian 12+ · Fedora</span>
        </a>
      </div>
    </div>
  </section>

  <section class="feature" aria-labelledby="faq-label">
    <div class="container">
      <div class="feature-head">
        <p class="figure-label" id="faq-label">FAQ</p>
      </div>
      <div class="faq">
        {
          faq.map((item) => (
            <div class="faq-item">
              <h2>{item.question}</h2>
              {item.answer.map((paragraph) => (
                <p set:html={html(paragraph)} />
              ))}
            </div>
          ))
        }
      </div>
      <a class="more" href={href('compare')}>How localhost compares to pm2, tmux, Docker Compose and others →</a>
    </div>
  </section>

  <section class="closing">
    <div class="container">
      <h2 class="display closing-title">Close the terminal tabs.</h2>
      <p class="lede">Configure a Project once. From then on, it is one click away.</p>
      <div class="ctas">
        <DownloadButton location="closing" />
        <a class="button button-secondary" href={href('docs')}>Read the docs</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { detectPlatform } from '../lib/platform';

  // The shortcuts are written for macOS; elsewhere they use Ctrl.
  if (detectPlatform() !== 'macos') {
    for (const key of document.querySelectorAll<HTMLElement>('kbd[data-other]')) key.textContent = key.dataset.other!;
  }
</script>

<style>
  .hero {
    position: relative;
    padding: 72px 0 40px;
    text-align: center;
    overflow: hidden;
  }
  /* A faint grid behind the headline, fading out towards the window. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 760px;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center -1px;
    mask-image: radial-gradient(60% 70% at 50% 30%, #000 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(60% 70% at 50% 30%, #000 30%, transparent 100%);
    pointer-events: none;
  }
  .hero > .container {
    position: relative;
  }
  .hero-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px 0 0;
  }
  .headline {
    font-size: clamp(42px, 7vw, 80px);
    margin-top: 24px;
    animation: focus-in 900ms var(--ease-out) both;
  }
  @keyframes focus-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(6px);
    }
  }
  .hero-lede {
    max-width: 560px;
    margin-top: 24px;
    animation: focus-in 900ms 120ms var(--ease-out) both;
  }
  .ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 36px;
  }
  .hero .ctas {
    animation: focus-in 900ms 220ms var(--ease-out) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .headline,
    .hero-lede,
    .hero .ctas {
      animation-name: fade-in;
      animation-duration: 400ms;
    }
    @keyframes fade-in {
      from {
        opacity: 0;
      }
    }
  }
  .platforms {
    margin: 16px 0 0;
    font-size: 14px;
    color: var(--text-tertiary);
  }
  .platforms a,
  .brew a {
    color: var(--text-secondary);
    text-underline-offset: 3px;
  }
  .brew {
    margin: 6px 0 0;
    font-size: 13px;
    color: var(--text-tertiary);
  }
  .brew code {
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 6px;
    border-radius: 999px;
    background: var(--page-raised);
    box-shadow: var(--ring);
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .pill:hover {
    color: var(--text);
  }
  .pill .mono {
    padding: 2px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent-text);
    font-size: 12px;
  }


  .stage {
    position: relative;
    margin-top: 72px;
  }
  .glow {
