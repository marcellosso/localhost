---
import Base from '../layouts/Base.astro';
import AppWindow from '../components/AppWindow.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { brewInstall, href, name, releases, repository, tagline } from '../lib/site';
import { definition, faq, html, plain } from '../lib/faq';
import { latestRelease } from '../lib/release';

const release = await latestRelease();
const description =
  'Free, open-source desktop process manager that runs your own dev commands, no Docker required, on macOS, Windows and Linux, with an MCP server for agents.';
const alternateName = ['localhost app', 'getlocalhost'];
const structuredData = [
  { '@type': 'WebSite', name, alternateName, url: Astro.site!.toString(), description: tagline },
  {
    '@type': 'SoftwareApplication',
    name,
    alternateName,
    description: definition,
    url: Astro.site!.toString(),
    image: new URL('/og.png', Astro.site).toString(),
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS 15 or later, Windows 10 or 11, Linux',
    ...(release.version === '<version>' ? {} : { softwareVersion: release.version }),
    downloadUrl: releases,
    featureList: [
      'Start, stop and restart dev servers, workers and databases from one window',
      'Runs your own commands natively, no Docker or containers required',
      'Start All in dependency order, with one merged log',
      'Services counted as Running once their Port accepts connections',
      'A Ports view of every process listening on a TCP port',
      'Variables, Environment Profiles and Secrets in the system’s secret store',
      'Services suggested from package.json, Compose files, Python apps and Cargo binaries',
      'An MCP server (localhost mcp) for Claude Code, Cursor, Codex and other coding agents',
      'In-app updates that stop running Services only after asking',
      'Projects on Windows itself or in a WSL 2 distro',
      'A command palette and a keyboard shortcut for every action',
    ],
    license: 'https://opensource.org/licenses/MIT',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    codeRepository: repository,
    author: {
      '@type': 'Person',
      name: 'Marcel Losso',
      url: 'https://github.com/marcellosso',
      sameAs: ['https://github.com/marcellosso', 'https://x.com/marcellosso'],
    },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer.map(plain).join('\n\n') },
    })),
  },
];

const directory = [
  { id: 'commands', label: 'Commands', text: 'Anything your terminal runs' },
  { id: 'ports', label: 'Ports', text: 'Who is on :3000' },
  { id: 'environment', label: 'Environment', text: 'Variables, Profiles, Secrets' },
  { id: 'agents', label: 'Coding agents', text: 'Claude Code, Cursor, Codex' },
  { id: 'local', label: 'Local-first', text: 'No account, nothing silent' },
  { id: 'install', label: 'Install', text: 'macOS, Windows, Linux' },
];

const commands = [
  ['Node', 'pnpm dev'],
  ['Bun', 'bun run dev'],
  ['Python', 'uv run fastapi dev'],
  ['Rust', 'cargo run'],
  ['Compose', 'docker compose up postgres'],
  ['Anything', './bin/dev --port $PORT'],
];

const problems = [
  ['Ports that collide', 'An agent runs pnpm dev while yours is already up, and the second copy fails on a taken port, or picks another port nobody told you about.'],
  ['Processes left behind', 'A dev server started in the agent’s shell can outlive the chat, holding its port and memory until you go looking for its pid.'],
  ['Logs nobody can see', 'Its output goes to a shell you can’t read, and the agent only sees what it captured, so a crash looks like silence.'],
];

---

<Base title={name} {description} {structuredData}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero-copy">
        <h1 id="hero-title" class="engraved">Open a project. Know how to run it.</h1>
        <div>
          <p class="lede">
            localhost is a free desktop app that remembers how each of your projects runs: commands, ports, environment. Pick a Project
            and start what you need, with every Service’s state, Port and log in one window.
          </p>
          <div class="actions" data-hero-cta>
            <DownloadButton location="hero" />
            <a class="button button-secondary github" href={repository} data-track="github_clicked" data-track-location="hero">
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
              </svg>
              View on GitHub
            </a>
            <div class="copy-command mac-only">
              <code>{brewInstall}</code>
              <button type="button" data-copy-text={brewInstall} data-track="install_command_copied" data-track-command="brew" data-track-location="hero">Copy</button>
            </div>
          </div>
          <p class="fine">
            Free and open source (MIT) · No account · <a
              href={href('docs/macos')}
              data-track="platform_docs_clicked"
              data-track-platform="macos"
              data-track-location="hero"
              aria-label="localhost on macOS">macOS</a>,{' '}
            <a
              href={href('docs/windows')}
              data-track="platform_docs_clicked"
              data-track-platform="windows"
              data-track-location="hero"
              aria-label="localhost on Windows">Windows</a>{' '}and{' '}
            <a
              href={href('docs/linux')}
              data-track="platform_docs_clicked"
              data-track-platform="linux"
              data-track-location="hero"
              aria-label="localhost on Linux">Linux</a>
          </p>
        </div>
      </div>
      <figure class="window-mount">
        <div class="bezel">
          <span class="screws" aria-hidden="true"></span>
          <AppWindow />
        </div>
        <figcaption>This window works: pick a Project, a Service or Ports, and start or stop anything.</figcaption>
      </figure>
    </div>
  </section>

  <nav class="container directory" aria-labelledby="directory-title">
    <div class="card">
      <h2 id="directory-title" class="card-title">Directory</h2>
      <ul>
        {
          directory.map((item) => (
            <li>
              <a href={`#${item.id}`}>
                <span class="tape word">{item.label}</span>
                <span class="dir-text">{item.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <section class="row" id="commands" aria-labelledby="commands-title">
    <div class="container">
      <div class="row-head">
        <h2 id="commands-title" class="engraved">If it runs in your terminal, it runs here.</h2>
        <div>
          <p class="lede">
            A Service is a folder, a command line and its environment, run in your login shell so <code>PATH</code>, version managers,
            pipes and <code>&amp;&amp;</code> work. Add a Project’s folder and localhost suggests Services from <code>package.json</code>,
            Compose files, Python apps and Cargo binaries; you check each one before anything is saved. No Docker or containers
            required: a Compose service is just one more Service.
          </p>
          <a class="more" href={href('docs/quick-start')}>Add your first Project</a>
        </div>
      </div>
      <dl class="panel inset strip">
        {
          commands.map(([runtime, command]) => (
            <div>
              <dt>{runtime}</dt>
              <dd><code>{command}</code></dd>
            </div>
          ))
        }
      </dl>

      <div class="pair">
        <div class="pair-item" id="ports">
          <h3 class="engraved">Know who’s on :3000.</h3>
          <p>
            The Ports view shows every process listening on a TCP port and whose it is. If a Service’s Port is taken, localhost says by whom
            and can start on the next free one, for that Run only. <a href={href('docs/ports')}>How Ports work</a> ·
            <a href={href('guides/port-already-in-use')}>Port already in use?</a>
          </p>
          <div class="panel inset" aria-hidden="true">
            <div class="port-row head"><span>Port</span><span>Process</span><span>Belongs to</span></div>
            <div class="port-row"><code>:8000</code><span>python3</span><span class="owner"><i style="--c: var(--service-1)"></i>Acme Shop › API</span></div>
            <div class="port-row"><code>:5173</code><span>node</span><span class="owner"><i style="--c: var(--service-3)"></i>Acme Shop › Web</span></div>
            <div class="port-row taken"><code>:3000</code><span>node</span><span class="owner faint">~/Code/experiments</span></div>
            <div class="port-row"><code>:6379</code><span>redis-server</span><span class="owner faint">Unmanaged</span></div>
            <div class="taken-note"><strong>Port 3000 is taken.</strong> Stop it and start, start on 3001, or cancel.</div>
          </div>
        </div>
        <div class="pair-item" id="environment">
          <h3 class="engraved">Environment without .env juggling.</h3>
          <p>
            Variables on the Project, on each Service and in Environment Profiles. Any of them can be a Secret, kept in Keychain, Secret
            Service or Credential Manager, never in a file. <a href={href('docs/environment')}>Environment and Secrets</a>
          </p>
          <div class="panel inset" aria-hidden="true">
            <div class="env-title">API’s environment <span class="segmented"><b>Development</b><span>Testing</span></span></div>
            <div class="env-row"><code>PATH</code><code class="value">~/.local/share/mise/shims:…</code><span class="from">login shell</span></div>
            <div class="env-row"><code>LOG_LEVEL</code><code class="value">debug</code><span class="from">Project</span></div>
            <div class="env-row"><code>DATABASE_URL</code><code class="value">postgres://localhost:5432/app</code><span class="from">Service</span></div>
            <div class="env-row"><code>STRIPE_KEY</code><code class="value secret">••••••••••••</code><span class="from accent">Secret</span></div>
            <div class="env-row"><code>NODE_ENV</code><code class="value">development</code><span class="from">Development</span></div>
            <div class="env-row"><code>PORT</code><code class="value">8000</code><span class="from">Port</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="row" id="agents" aria-labelledby="agents-title">
    <div class="container row-grid">
      <div class="row-copy">
        <h2 id="agents-title" class="engraved">Your coding agent flips the same switches.</h2>
        <p class="lede">
          <code>localhost mcp</code> lets Claude Code, Cursor and Codex start and stop your Services and read their logs and ports.
          What an agent starts shows in the window; it never starts a second copy, and it stops when the agent leaves, unless the app
          is open. Connect them from Settings in one click, or with <code>npx @getlocalhost/cli mcp install</code>.
        </p>
        <a class="more" href={href('agents')}>localhost for coding agents</a>
      </div>
      <div class="agent-stack">
        <dl class="problems">
          {
            problems.map(([title, text]) => (
              <div>
                <dt>{title}</dt>
                <dd>{text}</dd>
              </div>
            ))
          }
        </dl>
        <div class="transcript" aria-label="A coding agent using localhost mcp">
          <pre><span class="d">// a coding agent, through localhost mcp</span>
<span class="p">→</span> start_service <span class="d">{'{ project: "acme-shop", service: "web" }'}</span>
<span class="g">←</span> web   running  5173  <span class="d">startedBy:</span> agent
  api   running  8000  <span class="d">startedBy:</span> app</pre>
        </div>
      </div>
    </div>
  </section>

  <section class="row" id="local" aria-labelledby="local-title">
    <div class="container">
      <h2 id="local-title" class="engraved">Your machine, your rules.</h2>
      <ul class="rules">
        <li><span class="tape word">No account</span><p>No sign-in and no backend. Works offline, on your machine only.</p></li>
        <li><span class="tape word">Nothing in your repo</span><p>Configuration lives in localhost’s own storage. Export a Project file when you want to share one.</p></li>
        <li><span class="tape word">Nothing silent</span><p>No automatic restarts, and no Suggestion applied until you check it.</p></li>
        <li><span class="tape word">Native everywhere</span><p>SwiftUI on macOS, one light app for Linux and Windows, all on one Rust core.</p></li>
      </ul>
    </div>
  </section>

  <section class="row" id="install" aria-labelledby="install-title">
    <div class="container">
      <div class="row-head">
        <h2 id="install-title" class="engraved">Install</h2>
        <p class="lede">
          Releases aren’t notarized or signed by a known publisher yet, so macOS and Windows ask once at first launch. The install steps
          show exactly what to click.
        </p>
      </div>
      <div class="panel install-panel">
        <span class="screws" aria-hidden="true"></span>
        <div class="platform">
          <h3 class="plate-label">macOS</h3>
          <div class="copy-command">
            <code>{brewInstall}</code>
            <button type="button" data-copy-text={brewInstall} data-track="install_command_copied" data-track-command="brew" data-track-location="install">Copy</button>
          </div>
          <p>Homebrew also puts the <code>localhost</code> command on your PATH.</p>
          <button type="button" class="link" data-install-for="macos" data-track="install_opened" data-track-platform="macos">Or download the app</button>
          <span class="req">macOS 15 or later · Apple silicon or Intel</span>
        </div>
        <div class="platform">
          <h3 class="plate-label">Windows</h3>
          <p>Projects on Windows itself, or inside a WSL 2 distro. Installs for your user only, no administrator rights.</p>
          <button type="button" class="link" data-install-for="windows" data-track="install_opened" data-track-platform="windows">Install steps for Windows</button>
          <span class="req">Windows 10 or 11 · x64</span>
        </div>
        <div class="platform">
          <h3 class="plate-label">Linux</h3>
          <p><code>.deb</code>, <code>.rpm</code> and AppImage, with a tray icon. Secrets in the Secret Service.</p>
          <button type="button" class="link" data-install-for="linux" data-track="install_opened" data-track-platform="linux">Install steps for Linux</button>
          <span class="req">Ubuntu 22.04+ · Debian 12+ · Fedora</span>
        </div>
      </div>
    </div>
  </section>

  <section class="row" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <h2 id="faq-title" class="engraved">Questions</h2>
      <div class="faq">
        {
          faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              {item.answer.map((paragraph) => (
                <p set:html={html(paragraph)} />
              ))}
            </details>
          ))
        }
        <a class="more" href={href('compare')}>How localhost compares to pm2, tmux, Docker Compose and others</a>
        <a class="more" href={href('guides')}>Guides: ports in use, leftover dev servers, duplicate servers from agents</a>
      </div>
    </div>
  </section>

  <section class="close" aria-labelledby="close-title">
    <div class="container">
      <div class="panel close-panel">
        <span class="screws" aria-hidden="true"></span>
        <h2 id="close-title" class="engraved">Close the terminal tabs.</h2>
        <p class="lede">Configure a Project once. From then on, it is one switch away.</p>
        <div class="actions">
          <DownloadButton location="closing" />
          <div class="copy-command mac-only">
            <code>{brewInstall}</code>
            <button type="button" data-copy-text={brewInstall} data-track="install_command_copied" data-track-command="brew" data-track-location="closing">Copy</button>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>

<script>
  import { openInstall } from '../lib/platform';
  import type { Platform } from '../lib/release';

  for (const button of document.querySelectorAll<HTMLElement>('[data-install-for]')) {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      openInstall(button.dataset.installFor as Platform, false);
    });
  }
</script>

<style>
  .lede {
    max-width: 60ch;
  }
  .lede code,
  .platform code,
  .faq code {
    font-size: 0.88em;
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--fill);
    overflow-wrap: anywhere;
  }
  .more {
    margin-top: 24px;
  }
  .faq .more {
    display: flex;
    width: fit-content;
  }
  .faq .more + .more {
    margin-top: 12px;
  }

  /* Hero: the headline and the way in, then the live window, already in the first viewport. */
  .hero {
    padding: 64px 0 24px;
  }
  .hero-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: end;
    margin-bottom: 44px;
  }
  .hero h1 {
    font-size: clamp(50px, 6.2vw, 92px);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .fine {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .fine a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 3px;
    transition:
      color 150ms ease,
      text-decoration-color 150ms ease;
  }
  .fine a:hover {
    color: var(--accent-text);
    text-decoration-color: currentColor;
  }
  .window-mount {
    margin: 0;
  }
  .window-mount figcaption {
    margin-top: 14px;
    font-size: 14px;
    text-align: center;
    color: var(--text-secondary);
  }
  @media (max-width: 960px) {
    .hero-copy {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
  @media (max-width: 560px) {
    .actions > :global(.button),
    .actions .copy-command {
      width: 100%;
    }
    .github {
      order: 1;
    }
    .copy-command code {
      font-size: 12px;
    }
  }

  /* Rows */
  .row {
    padding: 96px 0 0;
  }
  .row-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 48px;
    align-items: end;
    margin-bottom: 32px;
  }
  .row h2 {
    font-size: clamp(40px, 5vw, 68px);
  }
  .row-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 64px;
    align-items: center;
    padding-top: 40px;
    border-top: 1px solid var(--separator);
  }
  .row-copy .lede {
    margin-top: 20px;
  }
  @media (max-width: 900px) {
    .row-head,
    .row-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }

  .bezel {
    padding: 34px;
    position: relative;
    border-radius: 14px;
    background: var(--page-raised);
    box-shadow:
      inset 0 1px 0 var(--plate-light),
      0 1px 0 var(--plate-edge),
      0 24px 50px -30px rgb(0 0 0 / 0.6);
  }
  @media (max-width: 560px) {
    .bezel {
      padding: 26px 10px 10px;
    }
  }

  .directory {
    margin-top: 72px;
  }
  .card {
    padding: 22px 26px 26px;
    border-radius: 4px;
    background: #fbfbf9;
    color: #1f2328;
    box-shadow: 0 10px 22px -16px rgb(0 0 0 / 0.6);
  }
  .card-title {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .card ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid #1f2328;
  }
  .card li {
    border-bottom: 1px solid rgb(0 0 0 / 0.14);
  }
  .card a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 8px 12px 0;
    color: inherit;
    text-decoration: none;
  }
  .card a:hover .dir-text {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .card .tape {
    background: #1f2328;
    color: #fff;
  }
  :global([data-theme='dark']) .card {
    background: var(--page-raised);
    color: var(--text);
    box-shadow:
      inset 0 1px 0 var(--plate-light),
      0 1px 0 var(--plate-edge);
  }
  :global([data-theme='dark']) .card ul {
    border-top-color: var(--separator);
  }
  :global([data-theme='dark']) .card li {
    border-bottom-color: var(--separator);
  }
  :global([data-theme='dark']) .card .tape {
    background: var(--text);
    color: var(--page);
  }
  :global([data-theme='dark']) .dir-text {
    color: var(--text-secondary);
  }
  .dir-text {
    font-size: 14px;
    color: #545c66;
  }
  @media (max-width: 900px) {
    .card ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .inset {
    padding: 10px;
    border-radius: 10px;
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: 0;
    padding: 0;
  }
  .strip div {
    padding: 16px 16px 18px;
  }
  .strip div + div {
    border-left: 1px solid var(--separator);
  }
  .strip dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .strip dd {
    margin: 6px 0 0;
    font-size: 13px;
    overflow-wrap: anywhere;
  }
  @media (max-width: 900px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .strip div:nth-child(odd) {
      border-left: 0;
    }
    .strip div:nth-child(n + 3) {
      border-top: 1px solid var(--separator);
    }
  }
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    margin-top: 72px;
  }
  .pair-item {
    display: flex;
    flex-direction: column;
    gap: 14px;
    scroll-margin-top: 88px;
  }
  .pair-item h3 {
    font-size: clamp(30px, 3.4vw, 44px);
  }
  .pair-item > p {
    margin: 0 0 6px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .pair-item > p a {
    color: var(--accent-text);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  @media (max-width: 900px) {
