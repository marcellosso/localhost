---
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';
---

<Base title="Page not found" description="This page doesn’t exist." noindex>
  <div class="container page">
    <div class="panel plate">
      <span class="screws" aria-hidden="true"></span>
      <span class="lamp" aria-hidden="true"></span>
      <p class="code engraved">404</p>
    </div>
    <h1 class="engraved">Nothing is listening here.</h1>
    <p class="lede">This page doesn’t exist, or it moved. Try the docs, or start from the home page.</p>
    <div class="actions">
      <a class="button button-primary" href={href('/')}>Home</a>
      <a class="button button-secondary" href={href('docs')}>Docs</a>
    </div>
  </div>
</Base>

<style>
  .page {
    padding-top: 96px;
    padding-bottom: 96px;
    text-align: center;
  }
  /* A small plate with its indicator unlit: the address has no Listener behind it. */
  .plate {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 36px 64px 30px;
    margin-bottom: 40px;
  }
  .lamp {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, color-mix(in srgb, var(--state-stopped) 55%, var(--page-raised)), var(--state-stopped) 75%);
    box-shadow:
      inset 0 1px 2px rgb(0 0 0 / 0.35),
      0 0 0 3px var(--page-sunken),
      0 0 0 4px var(--plate-edge);
    opacity: 0.7;
  }
  .code {
    font-size: clamp(88px, 14vw, 132px);
    line-height: 0.85;
    color: var(--text);
  }
  h1 {
    font-size: clamp(40px, 6vw, 64px);
  }
  .lede {
    margin: 20px auto 0;
    max-width: 480px;
  }
  .actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 32px;
  }
</style>
