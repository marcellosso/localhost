---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/prose.css';
import { guides, type Guide } from '../../lib/guides';
import { lastModified } from '../../lib/modified';
import { href, name, repository } from '../../lib/site';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const entry = await getEntry('guides', guide.slug);
if (!entry) throw new Error(`No Markdown for the guide “${guide.title}” (guides/${guide.slug}).`);
const { Content } = await render(entry);

const source = `site/src/content/guides/${guide.slug}.md`;
const others = guides.filter((other) => other !== guide);
const url = (path: string) => new URL(path, Astro.site).toString();
const structuredData = [
  {
    '@type': 'TechArticle',
    headline: guide.seoTitle,
    description: guide.description,
    url: url(href(`guides/${guide.slug}`)),
    dateModified: lastModified([`src/content/guides/${guide.slug}.md`]),
    isPartOf: { '@type': 'WebSite', name, url: url('/') },
    about: { '@type': 'SoftwareApplication', name, url: url('/'), applicationCategory: 'DeveloperApplication' },
    author: { '@type': 'Person', name: 'Marcel Losso' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Guides', item: url('/guides') },
      { '@type': 'ListItem', position: 2, name: guide.title, item: url(href(`guides/${guide.slug}`)) },
    ],
  },
];
---

<Base title={guide.seoTitle} description={guide.description} type="article" {structuredData}>
  <div class="container guide">
    <article>
      <nav class="crumbs plate-label" aria-label="Breadcrumb"><a href={href('guides')}>Guides</a></nav>
      <h1 class="engraved">{guide.title}</h1>
      <p class="description">{guide.description}</p>
      <div class="prose">
        <Content />
      </div>
      <a class="edit" href={`${repository}/edit/main/${source}`}>Edit this page on GitHub</a>
    </article>

    <aside class="more-guides" aria-labelledby="more-guides-title">
      <h2 id="more-guides-title" class="plate-label">More guides</h2>
      <ul>
        {
          others.map((other) => (
            <li>
              <a href={href(`guides/${other.slug}`)}>{other.title}</a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Base>

<style>
  .guide {
    display: grid;
    grid-template-columns: minmax(0, 740px) 240px;
    justify-content: space-between;
    gap: 56px;
    padding-top: 72px;
    padding-bottom: 96px;
    align-items: start;
  }
  article {
    min-width: 0;
  }
  .crumbs a {
    color: inherit;
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  h1 {
    margin-top: 14px;
    font-size: clamp(44px, 5vw, 64px);
  }
  .description {
    margin: 18px 0 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--separator);
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .edit {
    display: inline-block;
    margin-top: 48px;
    font-size: 13px;
    color: var(--text-secondary);
    text-underline-offset: 3px;
  }

  .more-guides {
    position: sticky;
    top: 88px;
    font-size: 14px;
  }
  .more-guides h2 {
    margin: 0 0 10px;
    font-size: 14px;
  }
  .more-guides ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--separator);
  }
  .more-guides a {
    display: block;
    padding: 5px 0 5px 12px;
    color: var(--text-secondary);
    text-decoration: none;
    line-height: 1.45;
  }
  .more-guides a:hover {
    color: var(--text);
  }
  @media (max-width: 900px) {
    .guide {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 48px;
    }
    .more-guides {
      position: static;
    }
  }
</style>
