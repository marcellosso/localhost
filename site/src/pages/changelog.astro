---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { changelog } from '../lib/changelog';
import { releases } from '../lib/site';

const entries = await Promise.all(
  (await changelog()).map(async ({ entry, ...data }) => ({ ...data, id: entry.id, Content: (await render(entry)).Content })),
);
const formatted = (date: Date) => date.toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base title="Changelog" description="What changed in each release of localhost, the app that runs every local project from one place." type="article">
  <div class="container page">
    <header>
      <p class="plate-label">Changelog</p>
      <h1 class="engraved">What’s new in localhost</h1>
      <p class="lede">Every release, newest first. Downloads are on <a href={releases}>GitHub Releases</a>.</p>
    </header>
    {
      entries.map((entry) => (
        <section class="entry" id={entry.version}>
          <div class="meta">
            <time datetime={entry.date.toISOString().slice(0, 10)}>{formatted(entry.date)}</time>
            <span class:list={['tape', 'version', { upcoming: !entry.released }]}>{entry.released ? `v${entry.version}` : 'Unreleased'}</span>
          </div>
          <div class="body">
            <h2 class="engraved">{entry.title}</h2>
            <entry.Content />
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .page {
    max-width: 960px;
    padding-top: 72px;
    padding-bottom: 96px;
  }
  header {
    margin-bottom: 56px;
  }
  h1 {
    margin-top: 12px;
    font-size: clamp(48px, 6vw, 80px);
  }
  .lede {
    margin-top: 20px;
  }
  .lede a {
    color: var(--accent-text);
    text-underline-offset: 3px;
  }

  /* Each release is a row of the panel's legend: its version on tape, the notes beside it. */
  .entry {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 40px;
    padding: 40px 0;
    border-top: 1px solid var(--separator);
    scroll-margin-top: 72px;
  }
  .meta {
    position: sticky;
    top: 96px;
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .version {
    height: 26px;
    padding: 0 10px;
    background: var(--text);
    color: var(--page);
    font-size: 13px;
  }
  /* Not released yet: tape with nothing printed, only an outline. */
  .version.upcoming {
    background: transparent;
    color: var(--text-secondary);
    box-shadow: inset 0 0 0 1px var(--separator);
  }
  time {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-secondary);
  }
  h2 {
    margin: 0 0 16px;
    color: var(--text);
    font-size: clamp(28px, 3vw, 34px);
    line-height: 1.05;
  }
  .body {
    min-width: 0;
    max-width: 68ch;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .body :global(p) {
    margin: 0 0 16px;
  }
  .body :global(ul) {
    margin: 0;
    padding-left: 20px;
  }
  .body :global(li) {
    margin-bottom: 8px;
  }
  .body :global(li::marker) {
    color: var(--text-tertiary);
  }
  .body :global(strong) {
    color: var(--text);
  }
  .body :global(a) {
    color: var(--accent-text);
    text-underline-offset: 3px;
  }
  .body :global(code) {
    font-size: 0.88em;
    padding: 2px 5px;
    border-radius: 5px;
    background: var(--fill);
    overflow-wrap: anywhere;
  }
  @media (max-width: 720px) {
    .page {
      padding-top: 48px;
    }
    .entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding: 32px 0;
    }
    .meta {
      position: static;
      flex-direction: row;
      align-items: center;
      gap: 12px;
    }
  }
</style>
