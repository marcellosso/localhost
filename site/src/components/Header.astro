---
import Wordmark from './Wordmark.astro';
import DownloadButton from './DownloadButton.astro';
import { href, repository } from '../lib/site';

const path = Astro.url.pathname;
const current = (section: string) => path.startsWith(href(section));
---

<header class="header" data-header>
  <div class="container inner">
    <a class="home" href={href('/')} aria-label="localhost home">
      <img src={href('favicon.svg')} width="24" height="24" alt="" />
      <Wordmark size={16} />
    </a>
    <nav id="site-nav" aria-label="Site">
      <a href={href('docs')} aria-current={current('docs') ? 'page' : undefined}>Docs</a>
      <a href={href('agents')} aria-current={current('agents') ? 'page' : undefined}>Agents</a>
      <a href={href('changelog')} aria-current={current('changelog') ? 'page' : undefined}>Changelog</a>
      <a href={repository} data-track="github_clicked" data-track-location="header">GitHub</a>
    </nav>
    <div class="actions">
      <button class="theme" type="button" data-theme-toggle aria-label="Switch to light appearance">
        <svg class="sun" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <circle cx="8" cy="8" r="3"></circle>
          <path d="M8 1.5v1.25M8 13.25v1.25M1.5 8h1.25M13.25 8h1.25M3.4 3.4l.9.9M11.7 11.7l.9.9M3.4 12.6l.9-.9M11.7 4.3l.9-.9"></path>
        </svg>
        <svg class="moon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
          <path d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1Z"></path>
        </svg>
      </button>
      <DownloadButton size="small" location="header" />
      <button class="menu" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu" data-menu>
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path class="bar top" d="M3 5.5h12"></path>
          <path class="bar bottom" d="M3 12.5h12"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const label = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    toggle.setAttribute('aria-label', dark ? 'Switch to light appearance' : 'Switch to dark appearance');
  };
  label();
  toggle.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
    label();
  });

  const header = document.querySelector<HTMLElement>('[data-header]')!;

  // On narrow screens the links fold into a menu under the header.
  const menu = header.querySelector<HTMLButtonElement>('[data-menu]')!;
  const setOpen = (open: boolean) => {
    header.toggleAttribute('data-open', open);
    menu.setAttribute('aria-expanded', String(open));
  };
  menu.addEventListener('click', () => setOpen(menu.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !header.hasAttribute('data-open')) return;
    setOpen(false);
    menu.focus();
  });
  document.addEventListener('click', (event) => {
    if (!header.contains(event.target as Node)) setOpen(false);
  });
  matchMedia('(min-width: 761px)').addEventListener('change', () => setOpen(false));

  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--page) 86%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 transparent;
    transition: box-shadow 200ms ease;
  }
  .header:global(.scrolled) {
    box-shadow: 0 1px 0 var(--plate-edge);
  }
  @media (prefers-reduced-transparency: reduce) {
    .header {
      background: var(--page);
    }
  }
  .inner {
    height: 60px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .home {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }
  nav a {
    padding: 6px 10px;
    border-radius: 6px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
    text-decoration: none;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }
  nav a:hover {
    color: var(--text);
    background: var(--fill);
  }
  /* The current section reads as a lit label. */
  nav a[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: 0;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .theme {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
  }
  .theme:hover {
    background: var(--fill);
    color: var(--text);
  }
  :global([data-theme='dark']) .moon,
  :global([data-theme='light']) .sun {
    display: none;
  }
  .menu {
    display: none;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .menu:hover {
    background: var(--fill);
  }
  .bar {
    transition: transform 200ms var(--ease-out);
  }
  /* Each bar turns about its own middle, then the two meet at the centre as an X. */
  .top {
    transform-origin: 9px 5.5px;
  }
  .bottom {
    transform-origin: 9px 12.5px;
  }
  .header[data-open] .top {
    transform: translateY(3.5px) rotate(45deg);
  }
  .header[data-open] .bottom {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .bar {
      transition: none;
    }
  }

  /* Narrow screens: logo, theme, Download and the menu button; the links drop down as a panel. */
  @media (max-width: 760px) {
    .inner {
      gap: 8px;
    }
    .home :global(.wordmark) {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
    .menu {
      display: grid;
    }
    nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      gap: 0;
      padding: 8px 0 12px;
      background: var(--page);
      box-shadow:
        inset 0 1px 0 var(--plate-edge),
        0 14px 24px -14px rgb(0 0 0 / 0.5);
    }
    .header[data-open] nav {
      display: flex;
    }
    nav a {
      padding: 12px 24px;
      border-radius: 0;
      font-size: 20px;
    }
    nav a[aria-current='page'] {
      box-shadow: inset 3px 0 0 var(--accent);
    }
  }
  @media (max-width: 760px) and (min-width: 480px) {
    .home :global(.wordmark) {
      display: inline;
    }
  }
</style>
